    <ranking>2</ranking>
    <name>Clean Windows OS Name</name>
    <description/>
    <match>AND</match>
    <is_active>0</is_active>
    <comment>/(Microsoft)(?&gt;\(R\)|®)? (Windows) (XP|\d\.\d|\d{1,4}|Vista)(™)? ?(.*)/

