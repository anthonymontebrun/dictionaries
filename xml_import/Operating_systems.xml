    <ruleaction>
      <action_type>append_regex_result</action_type>
      <field>name</field>
      <value>#1</value>
    </ruleaction>
  </rule>
  <rule>
    <entities_id>Root entity</entities_id>
    <sub_type>RuleDictionnaryOperatingSystem</sub_type>
    <ranking>3</ranking>
    <name>Clean Windows Server OS Name</name>
    <description/>
    <match>AND</match>
    <is_active>0</is_active>
    <comment>/(Microsoft)(?&gt;\(R\)|®)? (?:(Hyper-V|Windows)(?:\(R\))?) ((?:Server|))(?:\(R\)|®)? (\d{4}(?: R2)?)(?:[,\s]++)?([^\s]*)(?: Edition(?: x64)?)?$/

            Example :
            Microsoft Windows Server 2012 R2 Datacenter -&gt; #1 #2 : Windows Server
            Microsoft(R) Windows(R) Server 2003, Standard Edition x64 -&gt; #1 #2 : Windows Server
            Microsoft Hyper-V Server 2012 R2 -&gt; #1 #2 : Hyper-V Server
            Microsoft® Windows Server® 2008 Standard -&gt; #1 #2 : Windows Server</comment>
    <is_recursive>1</is_recursive>
    <uuid>clean_windows_server_os_name</uuid>
    <condition>0</condition>
    <date_creation>2025-05-06 11:07:59</date_creation>
    <rulecriteria>
      <criteria>os_name</criteria>
      <condition>6</condition>
      <pattern>/(Microsoft)(?&gt;\(R\)|®)? (?:(Hyper-V|Windows)(?:\(R\))?) ((?:Server|))(?:\(R\)|®)? (\d{4}(?: R2)?)(?:[,\s]++)?([^\s]*)(?: Edition(?: x64)?)?$/</pattern>
    </rulecriteria>
    <ruleaction>
      <action_type>append_regex_result</action_type>
      <field>name</field>
      <value>#1 #2</value>
    </ruleaction>
  </rule>
